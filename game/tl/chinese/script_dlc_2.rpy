# game/script_dlc_2.rpy:11469
translate chinese windsor_defence_3_fight_5551fff2:

    nvl clear
    "战场局势正在转变，战斗或许很快就要结束了。"

# game/script_dlc_2.rpy:11472
translate chinese windsor_defence_3_fight_76b2fe88_5:

