# game/script_dlc_2.rpy:11487
translate chinese windsor_defence_3_fight_44c42f1d:

    nvl clear
    "围城军借地穴潜入城中的图谋落了空。雇佣兵们拖走死伤的同伴，悻悻退去……"

# game/script_dlc_2.rpy:11489
