    ""

# game/script_dlc_2.rpy:19478
translate chinese duncan_in_windsor_4_postfight_7cc6c5df:

    nvl clear
    "{cps=50}你们没费多大力气便将来援不继的守军赶下城墙，终于突入城中。眼见你们得手，伯爵派来他的骑士接应……"

# game/script_dlc_2.rpy:19480
translate chinese duncan_in_windsor_4_postfight_76b2fe88:

    nvl clear
    ""

# game/script_dlc_2.rpy:19483
