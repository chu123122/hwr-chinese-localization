# game/script_dlc_2.rpy:16809
translate chinese sheriffs_arrival_postfight_e20110f9:

    nvl clear
    "{cps=50}在攻城方的猛攻之下，守军弃守一座塔楼，郡长的人马得以突入城堡……"

# game/script_dlc_2.rpy:16811
translate chinese sheriffs_arrival_postfight_76b2fe88:

    nvl clear
    ""

# game/script_dlc_2.rpy:16814
