    nvl clear
    ""

# game/script_dlc_2.rpy:16739
translate chinese sheriffs_arrival_fight_d40e534d:

    "{cps=50}局势正在变化，这场战斗或许很快就要结束了。"

# game/script_dlc_2.rpy:16741
translate chinese sheriffs_arrival_fight_76b2fe88_3:

    nvl clear
    ""

# game/script_dlc_2.rpy:16756
