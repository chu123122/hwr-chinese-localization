# game/script_dlc_2.rpy:28697
translate chinese roger_greenwich_postfight_7a8bc177:

    nvl clear
    "{cps=50}任务圆满完成，你得到了罗杰的称赞。"

# game/script_dlc_2.rpy:28707
translate chinese roger_greenwich_postfight_76b2fe88:

    nvl clear
    ""

