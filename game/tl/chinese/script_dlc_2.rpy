# game/script_dlc_2.rpy:8205
translate chinese oxford_camp_windsor_recon_fight_a50428d1:

    nvl clear
    "商队的护卫很快被尽数打倒，车上的货物任你劫掠。{color=#A9A9A9}{vspace=5}指挥官好感提升1点！"

