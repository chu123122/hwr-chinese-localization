translate chinese canterbury_duke_arrest_2_postfight_1aac2937:

    nvl clear
    "{cps=50}肃清剑桥城最后的守军后，你径直闯进公爵本人的居室。"

# game/script_dlc_2.rpy:25169
translate chinese canterbury_duke_arrest_2_postfight_76b2fe88:

