# game/script_dlc_2.rpy:22420
translate chinese canterbury_battle_for_london_postfight_0e5f76fb:

    nvl clear
    "{cps=50}你的队伍死战不退，合围只得了个半成。此时左右两翼的援军赶到，开始一步步将敌人向后逼退。"

# game/script_dlc_2.rpy:22422
translate chinese canterbury_battle_for_london_postfight_ac425912:

    nvl clear
    "{cps=50}战事渐趋胶着，缓缓化作两堵盾墙之间的消耗僵持。"

# game/script_dlc_2.rpy:22424
