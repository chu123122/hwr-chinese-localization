translate chinese grace_and_glory_player_accepts_tarrares_offer_80c03f3e:

    "{cps=50}料理掉这二人后，你提着格蕾丝与格洛丽的人头离开了酒馆。"

# game/script_dlc_3.rpy:53732
translate chinese grace_and_glory_player_accepts_tarrares_offer_76b2fe88:

    nvl clear
