# game/script_dlc_3.rpy:47247
translate chinese player_treats_bailifs_soldiers_with_alcohol_771f5cb8:

    nvl clear
    "{cps=50}眼见军纪与士气皆不尽人意，你决定用祖传的法子——以棍棒皮肉之罚，重振兵卒的纪律与锐气。"

# game/script_dlc_3.rpy:47249
translate chinese player_treats_bailifs_soldiers_with_alcohol_76b2fe88_1:

