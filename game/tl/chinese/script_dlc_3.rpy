# game/script_dlc_3.rpy:56390
translate chinese kingdom_new_sources_of_income_2_bdd8dbd9:

    nvl clear
    "{cps=50}遵你所命，他细细研究了增开新税、新捐的可能……{vspace=5}{color=#A9A9A9}权威——成功！"

# game/script_dlc_3.rpy:56392
