translate chinese kingdom_anna_arrives_2_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_3.rpy:56258
translate chinese kingdom_anna_arrives_2_94547691:

    "{cps=50}{color=#A9A9A9}钱不够！"

# game/script_dlc_3.rpy:56260
translate chinese kingdom_anna_arrives_2_76b2fe88:

    nvl clear
    ""

# game/script_dlc_3.rpy:56264
translate chinese kingdom_anna_arrives_2_56d0fc23:

    "{cps=50}你应允聘她入宫。{vspace=5}{color=#A9A9A9}花费[player_kingdom_gold_change]弗罗林！"

# game/script_dlc_3.rpy:56271
translate chinese kingdom_anna_arrives_2_ba9d7227:

    nvl clear
    "{cps=50}你信不过这位女子的本事，婉言谢绝。"

# game/script_dlc_3.rpy:56275
translate chinese kingdom_anna_arrives_2_76b2fe88_2:

    nvl clear
    ""

# game/script_dlc_3.rpy:56281
translate chinese kingdom_anna_arrives_3_89feb429:

    "{cps=50}一名宫廷神父请求觐见。"

# game/script_dlc_3.rpy:56282
translate chinese kingdom_anna_arrives_3_7d3c3758:

    nvl clear
    "{cps=50}他向你告发新来的宫廷医师安娜。"

# game/script_dlc_3.rpy:56284
translate chinese kingdom_anna_arrives_3_d8d0e970:

    nvl clear
    "{cps=50}他说，安娜对宗教殊无敬意，动辄对神职之人出言不逊。"

# game/script_dlc_3.rpy:56286
translate chinese kingdom_anna_arrives_3_360963ea:

    nvl clear
    "{cps=50}更有甚者，她竟敢质疑死亡不可逆转——这已是明目张胆的亵渎，无异于向天主本人叫板。"

# game/script_dlc_3.rpy:56288
translate chinese kingdom_anna_arrives_3_25f66d90:

    nvl clear
    "{cps=50}此等人物，不该留在宫廷之中。"

# game/script_dlc_3.rpy:56292
translate chinese kingdom_anna_arrives_3_76b2fe88:

    nvl clear
    ""

# game/script_dlc_3.rpy:56296
translate chinese kingdom_anna_arrives_3_439f5f44:

    "{cps=50}你认可他的说法，将安娜逐出宫廷。{vspace=5}{color=#A9A9A9}权威提升[player_kingdom_authority_change]。{vspace=5}声望（教会）提升[player_kingdom_rep_church_change]。"

# game/script_dlc_3.rpy:56299
translate chinese kingdom_anna_arrives_3_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_3.rpy:56304
translate chinese kingdom_anna_arrives_3_0b1aa002:

    "{cps=50}你未理会神父的告发。{vspace=5}{color=#A9A9A9}权威降低[player_kingdom_authority_change]。{vspace=5}声望（教会）降低[player_kingdom_rep_church_change]。{vspace=5}声望（贵族）降低[player_kingdom_rep_nobles_change]。{vspace=5}声望（平民）降低[player_kingdom_rep_commoners_change]。"

