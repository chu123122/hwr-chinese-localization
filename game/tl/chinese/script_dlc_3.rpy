# game/script_dlc_3.rpy:22232
translate chinese road_to_rouen_postfight_34e536a5:

    "{cps=50}你一报告通往鲁昂的道路已经肃清，德·罗什立刻下令准备开拔。{color=#A9A9A9}{vspace=5}你获得了休整与疗伤的时间。"

# game/script_dlc_3.rpy:22239
translate chinese road_to_rouen_postfight_76b2fe88:

    nvl clear
