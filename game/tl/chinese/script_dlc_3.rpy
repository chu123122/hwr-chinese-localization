# game/script_dlc_3.rpy:56531
translate chinese kingdom_archbishop_bad_arc_3_bad_61c9f4ff:

    nvl clear
    "{cps=50}你命他莫要干涉枢密顾问的私事。"

# game/script_dlc_3.rpy:56535
translate chinese kingdom_archbishop_bad_arc_3_bad_76b2fe88:

    nvl clear
    ""

