translate chinese grace_and_glory_escape_1_fight_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_3.rpy:52647
translate chinese grace_and_glory_escape_1_fight_76b2fe88_4:

    nvl clear
    ""

# game/script_dlc_3.rpy:52651
translate chinese grace_and_glory_escape_1_fight_76b2fe88_2:

    nvl clear
    ""

# game/script_dlc_3.rpy:52656
translate chinese grace_and_glory_escape_1_fight_894f78cb:

    nvl clear
    "{cps=50}{color=#A9A9A9}恢复了 [fatigue_to_recover] 点疲劳！"

