# game/script_dlc_3.rpy:11001
translate chinese kingdom_of_london_3_menu_campaigns_4c48d4e0:

    nvl clear
    "{cps=50}你决定组织一次征讨，夺取由北安普顿率领的效忠派军队据守的格林威治……"

# game/script_dlc_3.rpy:11011
translate chinese kingdom_of_london_3_menu_campaigns_44c5aa1c:

    nvl clear
    "{cps=50}你决定组织一次征讨，夺回被北安普顿率领的效忠派军队占据的奇彭纳姆……"

# game/script_dlc_3.rpy:11021
translate chinese kingdom_of_london_3_menu_campaigns_1c826e2c:

    nvl clear
    "{cps=50}你决定组织一次征讨，夺取被北安普顿率领的效忠派军队占据的布里斯托尔……"

# game/script_dlc_3.rpy:11031
translate chinese kingdom_of_london_3_menu_campaigns_dffbbcee:

    nvl clear
    "{cps=50}你决定组织一次征讨，夺取由北安普顿率领的效忠派军队据守的达特福德……"

# game/script_dlc_3.rpy:11042
translate chinese kingdom_of_london_3_menu_campaigns_faf7ce34:

    nvl clear
    "{cps=50}你决定对苏格兰人占据的土地发动进攻……"

# game/script_dlc_3.rpy:11052
translate chinese kingdom_of_london_3_menu_campaigns_faf7ce34_1:

    nvl clear
    "{cps=50}你决定对苏格兰人占据的土地发动进攻……"

# game/script_dlc_3.rpy:11062
translate chinese kingdom_of_london_3_menu_campaigns_faf7ce34_2:

    nvl clear
