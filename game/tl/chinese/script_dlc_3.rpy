# game/script_dlc_3.rpy:26345
translate chinese de_roche_summons_player_3e778a11:

    "{cps=50}一名信使找到了你，说德·罗什召你前去……"

# game/script_dlc_3.rpy:26347
translate chinese de_roche_summons_player_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_3.rpy:26351
translate chinese de_roche_summons_player_9b36cae2:

    nvl clear
    "{cps=50}……而且他已无意再等。"

# game/script_dlc_3.rpy:26353
translate chinese de_roche_summons_player_361c9e75:

    nvl clear
    "{cps=50}你无计可施，只能从命，即刻前往。"

# game/script_dlc_3.rpy:26355
