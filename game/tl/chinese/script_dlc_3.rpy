translate chinese kingdom_of_london_africa_1_fight_faa0c256:

    nvl clear
    "{cps=50}战斗陷入胶着。若无法速战速决，你便只能撤退……"

# game/script_dlc_3.rpy:14613
translate chinese kingdom_of_london_africa_1_fight_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_3.rpy:14726
translate chinese kingdom_of_london_5_1a22f40b:

    nvl clear
    "{cps=50}你听闻北安普顿与巴黎达成了某种协定，他的军队由此得到了来自法国的援兵。"

# game/script_dlc_3.rpy:14728
translate chinese kingdom_of_london_5_76b2fe88:

    nvl clear
    ""

# game/script_dlc_3.rpy:14731
translate chinese kingdom_of_london_5_76b2fe88_1:

    nvl clear
    ""

