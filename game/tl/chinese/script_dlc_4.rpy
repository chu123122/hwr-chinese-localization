# game/script_dlc_4.rpy:1066
translate chinese venice_tavern_silvertongue_db2e4621:

    nvl clear
    "{cps=50}你同意听他细说。"

# game/script_dlc_4.rpy:1068
translate chinese venice_tavern_silvertongue_e647f1f0:

    nvl clear
    "{cps=50}据这位陌生人说，他欠了威尼斯一位大银行家的债，而还债之期已近在眼前。"

