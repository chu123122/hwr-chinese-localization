    "{cps=50}{color=#A9A9A9}热那亚军队撤离地区：伊斯特拉"

# game/script_dlc_4.rpy:30890
translate chinese della_torre_castle_menu_36330ad5:

    "{cps=50}{color=#A9A9A9}热那亚军队撤离地区：弗留利"

