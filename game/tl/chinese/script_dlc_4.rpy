# game/script_dlc_4.rpy:1927
translate chinese saint_erasmo_visit_menu_47c661d6:

    nvl clear
    "{cps=50}你虽然初到威尼斯，却已博得了一个亡命之徒的名声——谁也不愿招惹你，谁也不愿对你说个“不”字。"

# game/script_dlc_4.rpy:1929
