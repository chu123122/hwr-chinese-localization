translate chinese doge_overthrow_1_fight_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:13231
translate chinese doge_overthrow_1_fight_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:13238
translate chinese doge_overthrow_1_fight_72787085:

    "{cps=50}你没能及时撤离广场，总督那队转入攻势的弩手追上了你。"

# game/script_dlc_4.rpy:13239
translate chinese doge_overthrow_1_fight_76b2fe88_2:

    nvl clear
    ""

# game/script_dlc_4.rpy:13325
translate chinese doge_overthrow_1_postfight_7933752b:

    nvl clear
    "{cps=50}你奋力挤出人潮，却惊愕地发现：广场的另一头，一队重甲卫兵同样挡住了退路，正把逃散者打得落花流水。"

# game/script_dlc_4.rpy:13331
translate chinese doge_overthrow_1_postfight_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:13574
translate chinese doge_overthrow_2_fight_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:13578
translate chinese doge_overthrow_2_fight_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:13649
translate chinese doge_overthrow_2_postfight_47b57637:

    nvl clear
    "{cps=50}刚摆脱弩手、冲到广场另一端，你便愕然发现退路又被堵死——这回是总督的另一队人马，清一色的重甲卫兵，正把逃散者打得血肉横飞。"

# game/script_dlc_4.rpy:13655
translate chinese doge_overthrow_2_postfight_76b2fe88:

    nvl clear
    ""

