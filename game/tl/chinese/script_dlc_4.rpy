    "{cps=50}{color=#A9A9A9}护腿遗失！"

# game/script_dlc_4.rpy:15597
translate chinese venice_bodyguard_chapter_5_end_76b2fe88_7:

    nvl clear
    ""

# game/script_dlc_4.rpy:15630
translate chinese venice_bodyguard_chapter_5_end_4ad02e19:

    "{cps=50}{color=#A9A9A9}护喉遗失！"

# game/script_dlc_4.rpy:15631
translate chinese venice_bodyguard_chapter_5_end_76b2fe88_8:

