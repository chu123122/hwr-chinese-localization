# game/script_dlc_4.rpy:25396
translate chinese little_black_book_intro_a758eab7:

    nvl clear
    "{cps=50}打探清楚埃齐奥·莫雷蒂在新犹太区的确切住处后，你盘算起下一步的行动……"

# game/script_dlc_4.rpy:25398
translate chinese little_black_book_menu_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:25402
translate chinese little_black_book_menu_3f72eb71:

    nvl clear
    "{cps=50}你决定不为不必复杂的事费心，索性提着武器径直闯进他家。"

# game/script_dlc_4.rpy:25404
translate chinese little_black_book_menu_3dfa5b1c:

    nvl clear
    "{cps=50}他身边的两名彪形护卫当即拔剑，朝你扑来。"

# game/script_dlc_4.rpy:25408
translate chinese little_black_book_menu_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:25414
translate chinese little_black_book_menu_76b2fe88_2:

    nvl clear
    ""

# game/script_dlc_4.rpy:25416
translate chinese little_black_book_menu_3ab59003:

    "{cps=50}{color=#A9A9A9}耗去时间：2"

# game/script_dlc_4.rpy:25417
translate chinese little_black_book_menu_9a429383:

    nvl clear
    "{cps=50}你不急于动手，先花些时日盯住埃齐奥的住所，摸清他的作息，寻找他护卫中的破绽。"

# game/script_dlc_4.rpy:25419
translate chinese little_black_book_menu_3a59dcde:

    nvl clear
    "{cps=50}一番观察下来，结论并不明朗。"

# game/script_dlc_4.rpy:25421
translate chinese little_black_book_menu_3dded2b4:

    nvl clear
    "{cps=50}埃齐奥身边贴身护卫不过两名彪形大汉，看上去似乎不足为惧。"

# game/script_dlc_4.rpy:25423
translate chinese little_black_book_menu_9d345a54:

    nvl clear
    "{cps=50}然而莫雷蒂栖身的街区里盘踞着不少他的狐朋狗党——你若动手之后不能立即脱身，他们必定蜂拥而至。"

# game/script_dlc_4.rpy:25425
translate chinese little_black_book_menu_52aeaa01:

    nvl clear
    "{cps=50}就你所见，埃齐奥的账簿从不离身，要弄到手只能在夜里下手。"

# game/script_dlc_4.rpy:25427
translate chinese little_black_book_menu_24433509:

    nvl clear
    "{cps=50}这需要过人的敏捷与协调，还要备齐相应的行头——藏身暗影的兜帽斗篷、对付门锁的开锁工具，以及一柄若与守卫狭路相逢、能无声解决对方的锋利匕首。"

# game/script_dlc_4.rpy:25431
translate chinese little_black_book_menu_76b2fe88_3:

    nvl clear
    ""

# game/script_dlc_4.rpy:25436
translate chinese little_black_book_menu_76b2fe88_4:

    nvl clear
    ""

# game/script_dlc_4.rpy:25442
translate chinese little_black_book_menu_48948573:

    nvl clear
    "{cps=50}{color=#A9A9A9}需要开锁工具！"

# game/script_dlc_4.rpy:25444
translate chinese little_black_book_menu_76b2fe88_5:

    nvl clear
    ""

# game/script_dlc_4.rpy:25451
translate chinese little_black_book_menu_c57c58ed:

    nvl clear
    "{cps=50}{color=#A9A9A9}需要兜帽斗篷！"

# game/script_dlc_4.rpy:25453
translate chinese little_black_book_menu_76b2fe88_6:

    nvl clear
    ""

# game/script_dlc_4.rpy:25460
translate chinese little_black_book_menu_8020f76d:

    nvl clear
    "{cps=50}{color=#A9A9A9}需要匕首！"

# game/script_dlc_4.rpy:25462
translate chinese little_black_book_menu_76b2fe88_7:

    nvl clear
    ""

# game/script_dlc_4.rpy:25468
translate chinese little_black_book_menu_8a3e67c1:

    "{cps=50}你决意暗中行事，伺机窃取账簿。"

# game/script_dlc_4.rpy:25469
translate chinese little_black_book_menu_95aa889b:

    nvl clear
    "{cps=50}得益于周密的准备，计划执行得堪称完美——你等到夜深人静，藏身于阴影之中，神不知鬼不觉地摸到莫雷蒂宅邸，用开锁工具潜入屋内。"

# game/script_dlc_4.rpy:25471
translate chinese little_black_book_menu_b21dfac5:

    nvl clear
    "{cps=50}朝思暮想的账簿就搁在床头柜上，旁边是床上安睡的主人。"

# game/script_dlc_4.rpy:25473
translate chinese little_black_book_menu_7d34f5c1:

    nvl clear
    "{cps=50}你揣起账簿，临别时用匕首在埃齐奥颈间划了一刀，把所有潜在的后患一并了结。"

# game/script_dlc_4.rpy:25477
translate chinese little_black_book_menu_76b2fe88_8:

    nvl clear
    ""

# game/script_dlc_4.rpy:25484
translate chinese little_black_book_chase_15c904fd:

    nvl clear
    "{cps=50}埃齐奥指望在新犹太区贫民窟的迷宫中摆脱你，他如鱼得水般穿梭于窄巷、门洞与后街之间。"

# game/script_dlc_4.rpy:25486
translate chinese little_black_book_chase_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:25488
translate chinese little_black_book_chase_ca4e57fe:

    "{cps=50}不过你也不是头一天到威尼斯，他那套把戏糊弄不了你。{vspace=5}{color=#A9A9A9}熟悉城市——判定成功！"

# game/script_dlc_4.rpy:25490
translate chinese little_black_book_chase_981fe50c:

    "{cps=50}你对城中道路并不熟识，渐渐被他甩开。{vspace=5}{color=#A9A9A9}熟悉城市——判定失败！"

# game/script_dlc_4.rpy:25491
translate chinese little_black_book_chase_a4c65983:

    nvl clear
    "{cps=50}{color=#A9A9A9}差距拉大了！"

# game/script_dlc_4.rpy:25501
translate chinese little_black_book_chase_064f5841:

    nvl clear
    "{cps=50}埃齐奥拼命狂奔，冲进一处熙熙攘攘的集市，想混入人群脱身。"

# game/script_dlc_4.rpy:25503
translate chinese little_black_book_chase_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:25505
translate chinese little_black_book_chase_d52bd8f4:

    "{cps=50}可惜这招没能奏效。你抡开肘臂，如破城战车般在人潮中碾出一条路来，挡道者尽数被撞开。{vspace=5}{color=#A9A9A9}力量——判定成功！"

# game/script_dlc_4.rpy:25507
translate chinese little_black_book_chase_e82741df:

    "{cps=50}在人的海洋里开路谈何容易，没过多久，埃齐奥便渐渐从你视野中消失。{vspace=5}{color=#A9A9A9}力量——判定失败！"

# game/script_dlc_4.rpy:25508
translate chinese little_black_book_chase_a4c65983_1:

    nvl clear
    "{cps=50}{color=#A9A9A9}差距拉大了！"

# game/script_dlc_4.rpy:25518
translate chinese little_black_book_chase_35118007:

    nvl clear
    "{cps=50}追捕仍在继续。埃齐奥穿街绕巷，奔到一座正在修建的圣母玛利亚大教堂前，纵身跃上脚手架，向上攀爬。"

# game/script_dlc_4.rpy:25520
translate chinese little_black_book_chase_76b2fe88_2:

    nvl clear
    ""

# game/script_dlc_4.rpy:25522
translate chinese little_black_book_chase_2f61653b:

    "{cps=50}你像猫一样矫健地紧随其后，寸步不离。{vspace=5}{color=#A9A9A9}敏捷——判定成功！"

# game/script_dlc_4.rpy:25524
translate chinese little_black_book_chase_73de98ba:

    "{cps=50}你想跟上他的脚步，可身手不够利索，终究撑不住埃齐奥的速度。{vspace=5}{color=#A9A9A9}敏捷——判定失败！"

# game/script_dlc_4.rpy:25525
translate chinese little_black_book_chase_a4c65983_2:

    nvl clear
    "{cps=50}{color=#A9A9A9}差距拉大了！"

# game/script_dlc_4.rpy:25532
translate chinese little_black_book_chase_b71ae514:

    nvl clear
    "{cps=50}埃齐奥看准时机，从脚手架上一跃，落到相邻建筑的瓦片屋顶。"

# game/script_dlc_4.rpy:25534
translate chinese little_black_book_chase_76b2fe88_3:

    nvl clear
    ""

# game/script_dlc_4.rpy:25536
translate chinese little_black_book_chase_06234c30:

    "{cps=50}你紧随其后。在陡斜的屋顶上稳如磐石，死死咬住逃窜者的尾巴。{vspace=5}{color=#A9A9A9}协调——判定成功！"

# game/script_dlc_4.rpy:25538
translate chinese little_black_book_chase_b87da86c:

    "{cps=50}你紧随其后，但在这斜屋顶上保持平衡，远比想象中艰难。{vspace=5}{color=#A9A9A9}协调——判定失败！"

# game/script_dlc_4.rpy:25539
translate chinese little_black_book_chase_71a8fd9e:

    nvl clear
    "{cps=50}为了不致失足坠落，你被迫放慢脚步，让逃犯又拉开了距离。"

# game/script_dlc_4.rpy:25541
translate chinese little_black_book_chase_a4c65983_3:

    nvl clear
    "{cps=50}{color=#A9A9A9}差距拉大了！"

# game/script_dlc_4.rpy:25551
translate chinese little_black_book_chase_392e7904:

    nvl clear
    "{cps=50}从屋顶落地后，埃齐奥虽已气喘吁吁，却仍保持着极快的步伐，沿着一条与运河平行的长街冲刺，指望在街尾的某个门洞里甩开你。"

# game/script_dlc_4.rpy:25553
translate chinese little_black_book_chase_76b2fe88_4:

    nvl clear
    ""

# game/script_dlc_4.rpy:25555
translate chinese little_black_book_chase_4f66b47e:

    "{cps=50}你的耐力尚有余裕，于是骤然加速，终于追上了埃齐奥。{vspace=5}{color=#A9A9A9}耐力——判定成功！"

# game/script_dlc_4.rpy:25557
translate chinese little_black_book_chase_bb50476f:

    "{cps=50}你的耐力已消耗殆尽，再也无法与他竞速。{vspace=5}{color=#A9A9A9}耐力——判定失败！"

# game/script_dlc_4.rpy:25560
translate chinese little_black_book_chase_66f46634:

    nvl clear
    "{cps=50}你从他怀中夺出那本渴求已久的账簿，一刀割开他的喉咙，把他推下运河——既了结了他的性命，也把他彻底送进了水里。"

# game/script_dlc_4.rpy:25564
translate chinese little_black_book_chase_76b2fe88_5:

    nvl clear
    ""

# game/script_dlc_4.rpy:25568
translate chinese little_black_book_fail_01ac1327:

    nvl clear
    "{cps=50}埃齐奥甩开你后，拐过街角，在威尼斯的大街小巷间消失得无影无踪。"

# game/script_dlc_4.rpy:25570
translate chinese little_black_book_fail_2f06c04d:

    nvl clear
    "{cps=50}你承认已无从寻觅他的踪迹，只好返回乔万娜处，向她禀报任务失利。"

# game/script_dlc_4.rpy:25572
translate chinese little_black_book_fail_e89641db:

    nvl clear
    "{cps=50}不出所料，乔万娜对这个结果颇感失望。"

# game/script_dlc_4.rpy:25574
translate chinese little_black_book_fail_071ff919:

    nvl clear
    "{cps=50}不过，听说你狠狠收拾了埃齐奥的手下、还险些将他本人当场了结后，她表示：这下他恐怕再无闲心向阿尔维扎讨债了。"

# game/script_dlc_4.rpy:25576
translate chinese little_black_book_fail_ff204b9a:

    nvl clear
    "{cps=50}所以至少在一段时间内，这件事可以暂时抛诸脑后。"

# game/script_dlc_4.rpy:25579
translate chinese little_black_book_fail_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:25933
translate chinese little_black_book_fight_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:25936
translate chinese little_black_book_fight_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:25996
translate chinese little_black_book_postfight_015caabb:

    nvl clear
    "{cps=50}眼见护卫不是你的对手，埃齐奥拔腿就逃。"

# game/script_dlc_4.rpy:25998
translate chinese little_black_book_postfight_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:26000
translate chinese little_black_book_postfight_21773897:

    "{cps=50}你在护卫身上耗掉的时间远超预期，被迫让埃齐奥占了大便宜——等你起脚追赶，已经落后了许多。"

# game/script_dlc_4.rpy:26001
translate chinese little_black_book_postfight_a4c65983:

    nvl clear
    "{cps=50}{color=#A9A9A9}差距拉大了！"

# game/script_dlc_4.rpy:26005
translate chinese little_black_book_postfight_f1b97759:

    "{cps=50}你瞬间击溃他的护卫，紧咬其后紧追不舍。"

# game/script_dlc_4.rpy:26008
translate chinese little_black_book_postfight_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:26020
translate chinese cannaregio_visit_3b35cf71:

    nvl clear
    "{cps=50}你造访了坎纳雷乔区的贫民窟……"

# game/script_dlc_4.rpy:26022
translate chinese cannaregio_visit_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:26027
translate chinese cannaregio_visit_menu_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:26039
translate chinese cannaregio_visit_menu_9ecfee31:

    nvl clear
    "{cps=50}你早已与威尼斯的黑道打过交道，很快便找到了能回答你问题的合适人选。{vspace=5}{color=#A9A9A9}低虔诚、犯案累累——判定成功！"

# game/script_dlc_4.rpy:26041
translate chinese cannaregio_visit_menu_07d6ed3c:

    nvl clear
    "{cps=50}从他们口中你得知，这水城之中外号“麻雀”的有好几位，但除一人外，全是成不了气候的小角色，干不出这样的大案。"

# game/script_dlc_4.rpy:26043
translate chinese cannaregio_visit_menu_e2470221:

    nvl clear
    "{cps=50}而那位“麻雀”本尊，是个半张脸带疤的彪形大汉，乃是纳波利塔诺的心腹——此人是本地一个大团伙的头目，多年来神秘莫测，屡屡逃脱法网。"

# game/script_dlc_4.rpy:26045
translate chinese cannaregio_visit_menu_d7aec70a:

    nvl clear
    "{cps=50}纳波利塔诺的人马栖身何处无人知晓，但据传朱代卡岛上圣科斯莫桥边的“诺蒂科”客栈，便是他的据点之一。"

# game/script_dlc_4.rpy:26048
translate chinese cannaregio_visit_menu_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:26053
