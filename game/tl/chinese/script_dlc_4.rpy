# game/script_dlc_4.rpy:39815
translate chinese venice_doge_chapter_3_end_9127d7f6:

    nvl clear
    "{cps=50}朱塞佩·卡瓦利继续公开抨击总督孔塔里尼。"

# game/script_dlc_4.rpy:39817
translate chinese venice_doge_chapter_3_end_a907fcea:

    nvl clear
    "{cps=50}聚集起来听他演说的支持者越来越多，卡瓦利的措辞也愈发尖刻、愈发肆无忌惮，距公开号召推翻现政权只差半步之遥。"

# game/script_dlc_4.rpy:39819
translate chinese venice_doge_chapter_3_end_76b2fe88_4:

    nvl clear
    ""

# game/script_dlc_4.rpy:39822
