# game/script_dlc_4.rpy:29628
translate chinese visit_austria_menu_6453c84a:

    "{cps=50}你取得了不小的进展，迫使利奥波德公爵放弃了部分要求。{vspace=5}{color=#A9A9A9}战斗胜利、兵力、所控地区——失败！"

# game/script_dlc_4.rpy:29629
translate chinese visit_austria_menu_76b2fe88_5:

    nvl clear
    ""

# game/script_dlc_4.rpy:29646
translate chinese visit_austria_menu_76b2fe88_6:

    nvl clear
    ""

# game/script_dlc_4.rpy:29650
translate chinese visit_austria_menu_b587e4b2:

    "{cps=50}但你一无所获。{vspace=5}{color=#A9A9A9}战斗胜利、兵力、所控地区——失败！"

