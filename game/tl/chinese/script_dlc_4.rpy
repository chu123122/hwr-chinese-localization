# game/script_dlc_4.rpy:30705
translate chinese milan_cathedral_visit_menu_2f51531d:

    nvl clear
    "{cps=50}这场围猎直到日落才收场。"

# game/script_dlc_4.rpy:30707
translate chinese milan_cathedral_visit_menu_76b2fe88_9:

    nvl clear
