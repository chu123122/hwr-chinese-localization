# game/script_dlc_4.rpy:20787
translate chinese santa_maria_nova_visit_menu_135f8287:

    nvl clear
    "{cps=50}{color=#A9A9A9}虔诚提升15点！"

# game/script_dlc_4.rpy:20790
translate chinese santa_maria_nova_visit_menu_76b2fe88_4:

    nvl clear
    ""

# game/script_dlc_4.rpy:20793
translate chinese santa_maria_nova_visit_menu_0ab802cd:

    "{cps=50}{color=#A9A9A9}所有属性提升1点！"

# game/script_dlc_4.rpy:20808
