translate chinese tenedos_island_intro_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:28223
translate chinese tenedos_island_intro_a2177c9c:

    "{cps=50}你未能抵达目的地——通往岛屿的水路已被热那亚舰队封锁，他们正围攻特内多斯岛上的威尼斯堡垒威尼迪克。"

# game/script_dlc_4.rpy:28225
translate chinese tenedos_island_intro_74b0eeb2:

    "{cps=50}你抵达了被热那亚舰队封锁的特内多斯岛附近海域。"

# game/script_dlc_4.rpy:28229
translate chinese tenedos_island_menu_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:28234
translate chinese tenedos_island_menu_fff88f0a:

    "{cps=50}你与一位当地渔夫说定，待到夜色浓黑、不见月光之夜，乘他的小船悄然登岛，避过所有热那亚海上巡逻。"

# game/script_dlc_4.rpy:28235
translate chinese tenedos_island_menu_52b6dfd8:

    nvl clear
    "{cps=50}{color=#A9A9A9}损失时间：1{vspace=5}损失弗罗林：5"

# game/script_dlc_4.rpy:28239
translate chinese tenedos_island_menu_dc10b18d:

    "{cps=50}{color=#A9A9A9}时间不足！"

# game/script_dlc_4.rpy:28242
translate chinese tenedos_island_menu_94547691:

    "{cps=50}{color=#A9A9A9}钱财不足！"

# game/script_dlc_4.rpy:28248
translate chinese tenedos_island_menu_45ced28d:

    "{cps=50}{color=#A9A9A9}威望——成功！"

# game/script_dlc_4.rpy:28250
translate chinese tenedos_island_menu_e2ca98be:

    nvl clear
    "{cps=50}你凭着自己的身份，寻机将一封信递到热那亚舰队队长手中，信里提议——以互利为条件——准许你登岛一行。"

# game/script_dlc_4.rpy:28252
translate chinese tenedos_island_menu_5e2318e9:

    nvl clear
    "{cps=50}队长同意通融，只要你奉上一份薄礼——[venedic_fortress_access_cost!i]弗罗林。"

# game/script_dlc_4.rpy:28254
translate chinese tenedos_island_menu_ad46e8bd:

    nvl clear
    "{cps=50}除钱财之外，他唯一的条件是：你须独自一人，不得携带任何货物。"

# game/script_dlc_4.rpy:28258
translate chinese tenedos_island_menu_c6d62de3:

    "{cps=50}{color=#A9A9A9}威望——失败！"

# game/script_dlc_4.rpy:28259
translate chinese tenedos_island_menu_142fa22d:

    nvl clear
    "{cps=50}你试图约见热那亚舰队队长，或至少托人转交书信，却无人肯与你打交道。"

# game/script_dlc_4.rpy:28265
translate chinese tenedos_island_menu_fb92774b:

    "{cps=50}收下所索之资后，队长便放你登岛。"

# game/script_dlc_4.rpy:28266
translate chinese tenedos_island_menu_effe3aa3:

    nvl clear
    "{cps=50}{color=#A9A9A9}损失弗罗林：[venedic_fortress_access_cost]"

# game/script_dlc_4.rpy:28271
translate chinese tenedos_island_menu_94547691_1:

    "{cps=50}{color=#A9A9A9}钱财不足！"

# game/script_dlc_4.rpy:28276
translate chinese tenedos_island_menu_a9d8fb48:

    "{cps=50}你向热那亚舰队队长恳求，至少让你从岛上带走一名伤员，却遭断然拒绝。"

# game/script_dlc_4.rpy:28277
translate chinese tenedos_island_menu_a6913a04:

    nvl clear
    "{cps=50}他唯一肯让步的，是若守军献城缴械，便放所有守军平安归家。"

# game/script_dlc_4.rpy:28282
translate chinese tenedos_island_menu_a77a2f4f:

    nvl clear
    "{cps=50}你决意返回威尼斯。"

# game/script_dlc_4.rpy:28284
translate chinese tenedos_island_menu_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:28298
translate chinese venedic_fortress_intro_e22761a2:

    nvl clear
    "{cps=50}你抵达威尼迪克堡……"

# game/script_dlc_4.rpy:28303
translate chinese venedic_fortress_intro_53a0cc91:

    nvl clear
    "{cps=50}尽管城墙巍峨难撼，威尼迪克堡的守备状况却已颓败不堪。"

# game/script_dlc_4.rpy:28305
translate chinese venedic_fortress_intro_355ce428:

    nvl clear
    "{cps=50}原因主要在于守军久被围困、筋疲力尽，又饱受疾病与伤亡的消耗，伤员不计其数。"

# game/script_dlc_4.rpy:28307
translate chinese venedic_fortress_intro_053640ea:

    nvl clear
    "{cps=50}阿莱西奥也在其中——他此前不久受了重伤，如今正在堡内一间医务室里，靠最后一口气撑持。"

# game/script_dlc_4.rpy:28311
translate chinese venedic_fortress_intro_menu_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:28315
translate chinese venedic_fortress_intro_menu_a8c63fdc:

    "{cps=50}堡中传来噩耗：阿莱西奥已伤重不治。"

# game/script_dlc_4.rpy:28317
translate chinese venedic_fortress_intro_menu_76b2fe88_1:

    nvl clear
    ""

# game/script_dlc_4.rpy:28323
translate chinese venedic_fortress_intro_menu_38430e54:

    "{cps=50}你将所需之物尽数交给堡中医生，令他稳住了阿莱西奥的伤势，将笼罩其上的死神阴影驱散。"

# game/script_dlc_4.rpy:28324
translate chinese venedic_fortress_intro_menu_8ab2efac:

    nvl clear
    "{cps=50}然而，如何将阿莱西奥救出堡垒，仍是悬而未决之事。"

# game/script_dlc_4.rpy:28327
translate chinese venedic_fortress_intro_menu_76b2fe88_2:

    nvl clear
    ""

# game/script_dlc_4.rpy:28334
translate chinese venedic_fortress_intro_menu_12e0084d:

    nvl clear
    "{cps=50}阿莱西奥急需救治，手术刻不容缓。"

# game/script_dlc_4.rpy:28336
translate chinese venedic_fortress_intro_menu_8ef69108:

    nvl clear
    "{cps=50}否则，他随时都可能命丧黄泉。"

# game/script_dlc_4.rpy:28338
translate chinese venedic_fortress_intro_menu_e0194e39:

    nvl clear
    "{cps=50}据堡中医生说，为阿莱西奥动手术，需要一套外科器械和消毒绷带。"

# game/script_dlc_4.rpy:28343
translate chinese venedic_fortress_intro_menu_76b2fe88_3:

    nvl clear
    ""

# game/script_dlc_4.rpy:28347
translate chinese venedic_fortress_intro_menu_1ff5cf1c:

    "{cps=50}{color=#A9A9A9}失去物品——[field_surgical_kit.name!ti]"

# game/script_dlc_4.rpy:28351
translate chinese venedic_fortress_intro_menu_76b2fe88_4:

    nvl clear
    ""

# game/script_dlc_4.rpy:28355
translate chinese venedic_fortress_intro_menu_88815af0:

    "{cps=50}{color=#A9A9A9}失去物品——[aseptic_bandage.name!ti]"

# game/script_dlc_4.rpy:28360
translate chinese venedic_fortress_intro_menu_a65b6b2b:

    nvl clear
    "{cps=50}与要塞司令交谈后你得知，守军已接近强弩之末，若无补给及时接济，恐怕撑不了多久。"

# game/script_dlc_4.rpy:28362
translate chinese venedic_fortress_intro_menu_76b2fe88_5:

    nvl clear
    ""

# game/script_dlc_4.rpy:28367
translate chinese venedic_fortress_intro_menu_26866928:

    nvl clear
    "{cps=50}你向司令提议为要塞补充给养，他便交给你一份守军的急需清单……"

# game/script_dlc_4.rpy:28369
translate chinese venedic_fortress_intro_menu_6d12fc2e:

    nvl clear
    "{cps=50}一是药品。{vspace=5}以药物和止血的凝血剂为主。"

# game/script_dlc_4.rpy:28371
translate chinese venedic_fortress_intro_menu_fb358b40:

    nvl clear
    "{cps=50}二是洁净的饮用水。{vspace=5}堡中饮水十分匮乏。"

# game/script_dlc_4.rpy:28373
translate chinese venedic_fortress_intro_menu_43004dbc:

    nvl clear
    "{cps=50}三是兵员。{vspace=5}一整队士兵固然无法运上岛，但据司令说，即便只添几名得力战士——尤其是弩手——也能大有助益。"

# game/script_dlc_4.rpy:28381
translate chinese venedic_fortress_intro_support_76b2fe88:

    nvl clear
    ""

# game/script_dlc_4.rpy:28384
