    ""

# game/script_dlc_4.rpy:35279
translate chinese charles_tells_about_tarrare_5cabccc2:

    cha "{cps=50}Если ты и правда тот, кем я тебя считаю, то ты и сам легко его отыщешь.{vspace=5}{w}Ну а если нет..."
