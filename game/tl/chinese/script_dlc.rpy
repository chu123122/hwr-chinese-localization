# game/script_dlc.rpy:41944
translate chinese cecilia_give_hunting_sword_f10346b4:

    c "{cps=50}Мда-а-а-а, я вроде бы просила меч для самозащиты, а не для охоты на кабанов.{vspace=5}{color=#A9A9A9}Relationship (Cecilia) lowered by 2!"
    ""

# game/script_dlc.rpy:41946
translate chinese cecilia_give_hunting_sword_cff2416b:

