# game/script_dlc.rpy:29227
translate chinese the_sword_quest_2_fail_053a620a:

    h "{cps=50}Предложение мне нравится, но принц и эрл неплохо мне платят. Очень неплохо."
    ""

# game/script_dlc.rpy:29228
translate chinese the_sword_quest_2_fail_688efdd2:

    h "{cps=50}Как насчет..."
    ""

# game/script_dlc.rpy:29229
