    h "{cps=50}Я куплю этот судук."
    ""

# game/script_dlc.rpy:47282
translate chinese blacksmith_talk_0_18b6c734:

    bl "{cps=50}Серьезно!?{w} Хм, ну отлично. Он твой."
    ""

# game/script_dlc.rpy:47283
translate chinese blacksmith_talk_0_46e50e39:

    dn "{color=#A9A9A9}{cps=50}-30 Флоринов!{vspace=5}Получен предмет — Сундук!"
    ""

