    nvl clear
    ""

# game/script_dlc.rpy:51813
translate chinese hunt_1_poison_end_a3001e6b:

    nvl clear
    "{cps=50}你坦言自己爱莫能助，便继续赶路了。"

# game/script_dlc.rpy:51815
translate chinese hunt_1_poison_end_76b2fe88_1:

    nvl clear
