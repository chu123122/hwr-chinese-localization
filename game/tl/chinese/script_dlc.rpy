# game/script_dlc.rpy:31382
translate chinese case_windsor_fail_a9f32401:

    nvl clear
    "{cps=50}眼见战事毫无进展，北安普顿又听闻坎特伯雷的主力正向温莎逼近，便下令承认温莎已失守，全军撤回伦敦。{vspace=5}{color=#A9A9A9}声望（伯爵）减少30！{vspace=5}声望（士兵）减少10！{vspace=5}威望减少1！"

