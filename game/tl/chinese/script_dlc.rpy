# game/script_dlc.rpy:17452
translate chinese woods_and_goddess_quest_quit_7681060f:

    nvl clear
    "{cps=50}若真是匪徒作祟，安娜只需差遣那几个听她使唤的雇佣兵来取吊坠便是。"

