    nvl clear
    "{cps=50}你把水分给了他们。{vspace=5}{color=#A9A9A9}美德提升20！"

# game/script_dlc.rpy:25095
translate chinese el_mansur_crusaders_6e7c7838_1:

    nvl clear
    "{cps=50}他们千恩万谢，随后继续赶路。"

# game/script_dlc.rpy:25098
